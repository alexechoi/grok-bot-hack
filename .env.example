# Never use NEXT_PUBLIC_ for any value here. Node.js >=22.13 required.
# Fresh login: npm run grok:login -> secure .caretakr/grok-credentials.json
GROK_BOT_CREDENTIALS_FILE=.caretakr/grok-credentials.json
# Alternative server-only credential (do not commit):
# GROK_BOT_ACCESS_TOKEN=
# GROK_BOT_TEAM_ID=
GROK_BOT_CLIENT_VERSION=0.78.1
GROK_BOT_TIMEOUT_MS=180000
# Generate secrets with npm run grok:setup (writes .env.local without printing secrets).
CARETAKR_OPERATOR_TOKEN=
CARETAKR_SESSION_SECRET=
CARETAKR_MCP_INSPECTOR_TOKEN=
CARETAKR_MCP_ENERGY_TOKEN=
CARETAKR_MCP_MAINTENANCE_TOKEN=
CARETAKR_MCP_MANAGER_TOKEN=
# Public HTTPS origin for social preview image URLs and Grok Bot's cloud computer.
# Set this before building on hosts without Netlify URL / Vercel production URL variables.
CARETAKR_PUBLIC_URL=
# Create the four roles in the native Grok Bot app, then npm run grok:provision discovers and saves their IDs.
GROK_BOT_INSPECTOR_ID=
GROK_BOT_ENERGY_ID=
GROK_BOT_MAINTENANCE_ID=
GROK_BOT_MANAGER_ID=

# Hosted browser access. Set a private 12+ character passcode in Netlify, never NEXT_PUBLIC_.
# CARETAKR_WORKSPACE_PASSWORD=
# Hosted jobs use native Background Functions and private, shared Netlify Blobs.
# Use Node 24 and keep CARETAKR_SESSION_SECRET stable across deploys.
